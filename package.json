{
  "name": "studypilot",
  "version": "1.0.0",
  "description": "StudyPilot - AI-powered study planner for students with ADHD",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/**"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:headed": "turbo run test:e2e:headed",
    "test:e2e:report": "pnpm --filter @studypilot/web exec playwright show-report",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "email:up": "docker compose -f compose.mailpit.yml up -d",
    "email:down": "docker compose -f compose.mailpit.yml down",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/api/src/**/*.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "apps/web/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx,js,jsx,cjs,mjs}": [
      "prettier --write"
    ],
    "**/package.json": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}

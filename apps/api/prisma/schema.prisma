// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  emailVerifiedAt             DateTime?
  emailVerificationRequestedAt DateTime?
  passwordResetRequestedAt    DateTime?
  // SP-106A: profile preferences (D106-1) — first-class time zone column
  // (later epics depend on it directly) plus a nullable JSON bag for future
  // minimal prefs (EP06 study defaults). Purely additive: existing rows
  // backfill to "UTC" / NULL.
  timeZone                    String    @default("UTC")
  preferences                 Json?
  // SP-107A: onboarding wizard state (D107-1) — three additive columns.
  // Existing users are backfilled to completed (D107-2).
  onboardingStep              Int       @default(1)
  onboardingCompletedAt       DateTime?
  onboardingSemesterId        String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  // Relations
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  refreshTokens           RefreshToken[]
  semesters         Semester[]
  courses           Course[]
  assignments       Assignment[]
  tasks             Task[]
  studySessions     StudySession[]
  studyPlans        StudyPlan[]
  availabilitySlots AvailabilitySlot[]
  classMeetings     ClassMeeting[] // SP-112A (D112-1)

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@map("email_verification_tokens")
}

model RefreshToken {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId         String
  tokenHash        String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedByTokenId String?
  createdAt        DateTime  @default(now())

  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@map("password_reset_tokens")
}

// SP-105F: shared per-IP rolling-window admission for the public recovery
// endpoints (SP-105F, SD8). Rate-limit state only — deliberately NOT related
// to User: buckets are keyed by endpoint + normalized client IP, so they must
// never carry or scope academic/credential data, and no ownership helper
// applies. `admittedAt` holds at most the endpoint's limit of window entries
// (pruned on every admission); no emails, tokens, or request bodies.
model RecoveryRateLimitBucket {
  id           String     @id @default(uuid())
  endpoint     String
  normalizedIp String
  admittedAt   DateTime[] @default([])
  updatedAt    DateTime   @updatedAt

  @@unique([endpoint, normalizedIp])
  @@map("recovery_rate_limit_buckets")
}

// ============================================
// ACADEMIC STRUCTURE
// ============================================

model Semester {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   // e.g., "Fall 2024"
  // SP-107B (D107-7): calendar dates, not instants — follows the
  // `StudyPlan.date @db.Date` precedent; the API serializes them as
  // `yyyy-MM-dd` (no time-zone ambiguity).
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  courses Course[]

  @@unique([userId, name])
  @@map("semesters")
}

model Course {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterId  String?
  semester    Semester? @relation(fields: [semesterId], references: [id])
  code        String   // e.g., "CS101"
  name        String   // e.g., "Introduction to Computer Science"
  description String?
  instructor  String?  // SP-111A (D111-1): nullable, ≤ 100 chars after trim
  color       String   @default("#6366f1") // Default indigo
  credits     Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  assignments Assignment[]
  meetings    ClassMeeting[] // SP-112A (D112-2): recurring weekly schedule

  @@unique([userId, code])
  @@map("courses")
}

// SP-112A (D112-1): recurring class meetings — the `AvailabilitySlot`
// precedent for weekly times: `dayOfWeek` 0–6 (Sunday=0 … Saturday=6) plus
// `startTime`/`endTime` as `HH:mm` 24-hour strings; `endTime` is strictly
// after `startTime` on the same day (no midnight wrap in the MVP, enforced
// by the API — the schema stores the strings).  `courseId` cascades
// (D112-4, safety net only — the MVP exposes no course hard-delete);
// `userId` scopes every query (repo ownership convention).
model ClassMeeting {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0-6 (Sunday-Saturday)
  startTime String   // HH:mm format
  endTime   String   // HH:mm format
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, dayOfWeek, startTime])
  @@map("class_meetings")
}

// ============================================
// ASSIGNMENTS & TASKS
// ============================================

model Assignment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id])
  title       String
  description String?
  dueDate     DateTime?
  estimatedHours Float?  // Estimated hours needed
  actualHours  Float?  // Tracked hours spent
  status      AssignmentStatus @default(PENDING)
  priority    AssignmentPriority @default(MEDIUM)
  // SP-115G (D115-1): optional closed assignment type. Stored identifiers,
  // nullable with no default — an omitted/untyped create stays null (D115-2).
  type        AssignmentType?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tasks Task[]
  plannedSessions PlannedSession[]
  studySessions StudySession[]
  
  @@map("assignments")
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SUBMITTED
  GRADED
}

enum AssignmentPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// SP-115G (D115-1): the epic's named assignment categories, stored as
// identifiers. Optional on the API means null — not a sixth stored value.
enum AssignmentType {
  HOMEWORK
  PAPER
  PROJECT
  QUIZ
  EXAM
}

model Task {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment  Assignment? @relation(fields: [assignmentId], references: [id])
  // EP07A: inverse relation for StudySession.taskId (SetNull on delete).
  studySessions StudySession[]
  title       String
  description String?
  dueDate     DateTime?
  estimatedMinutes Int?
  actualMinutes   Int?
  status      TaskStatus @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

 
  @@map("tasks")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// ============================================
// STUDY PLANNING & SCHEDULING
// ============================================

model StudySession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment  Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  taskId      String?
  task        Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  startTime   DateTime
  endTime     DateTime?
  status      StudySessionStatus @default(ACTIVE)
  elapsedSeconds Int @default(0)
  durationMinutes Int    @default(0) // Calculated (confirmed minutes)
  plannedMinutes Int?
  notes       String?
  isFocusMode Boolean  @default(true)
  rating      Int?      // 1-5 user rating
  resumedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, startTime])
  @@map("study_sessions")
}

enum StudySessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model AvailabilitySlot {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 0-6 (Sunday-Saturday)
  startTime   String   // HH:mm format
  endTime     String   // HH:mm format
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, dayOfWeek, startTime])
  @@map("availability_slots")
}

model StudyPlan {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  targetHours Float    // Target study hours for this day
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sessions PlannedSession[]
 
  @@unique([userId, date])
  @@map("study_plans")
}

model PlannedSession {
  id          String   @id @default(uuid())
  studyPlanId String
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment  Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime
  durationMinutes Int
  status      PlannedSessionStatus @default(SCHEDULED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studyPlanId])
  @@index([assignmentId])
  @@map("planned_sessions")
}

enum PlannedSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  RESCHEDULED
}
